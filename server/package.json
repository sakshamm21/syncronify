{
  "name": "syncronify-server",
  "version": "2.0.0",
  "description": "Syncronify REST + realtime API",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "dev:memory": "tsx scripts/dev-memory.ts",
    "seed": "tsx scripts/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "typecheck": "tsc && tsc -p test",
    "test": "node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\""
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "nodemailer": "^10.0.13",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
