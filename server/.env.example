# Server port
PORT=4000

# MongoDB connection string
DB_URI=mongodb://127.0.0.1:27017/syncronify

# Secret used to sign JWT tokens — CHANGE THIS in production!
JWT_SECRET=change_this_to_a_long_random_string

# Frontend origin (for CORS)
CLIENT_URL=http://localhost:3000

# SMTP / email — required for OTP emails to actually be delivered.
# Free option: Brevo (https://www.brevo.com) → Settings → SMTP & API → SMTP.
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_MAIL=<your verified sender email>
#   SMTP_PASSWORD=<your generated master password>
# If left empty, OTP emails are logged to the server console instead (dev only).
SMTP_HOST=
SMTP_PORT=
SMTP_SERVICE=
SMTP_MAIL=
SMTP_PASSWORD=
