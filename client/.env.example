# Base URL of the Syncronify API (the `server/` app), reachable from the browser.
# Local: http://localhost:4000   Production: https://syncronify-api.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:4000

# Show one-click demo account buttons on the sign-in page.
# Only useful with data from `npm --prefix server run seed`.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
